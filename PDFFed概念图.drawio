        <mxCell id="agg" value="服务器聚合&#10;全局原型 / 分类头校正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="530" width="230" height="80" as="geometry" />
