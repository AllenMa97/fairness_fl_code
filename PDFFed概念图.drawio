        <mxCell id="slogan" value="协同闭环成立&#10;φ 管公平（L_PA）、w 管精度（L_l2l）&#10;参数作用域不相交 → 同时执行、互不冲突" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontStyle=1;" vertex="1" parent="1">
