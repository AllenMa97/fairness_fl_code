<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="pdf-fed-concept" name="PDFFed 概念图">
    <mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="PDFFed：一个载体 · 两条路径 · 一个闭环" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="234" y="20" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="类-组原型驱动的群组公平—精度协同优化" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;fontColor=#7F7F7F;" vertex="1" parent="1">
          <mxGeometry x="334" y="72" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="center" value="类-组原型（CG Proto）&#10;统一知识载体&#10;同时编码 类别 × 群组 分布信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="419" y="290" width="330" height="150" as="geometry" />
        </mxCell>

        <mxCell id="fr" value="公平性路径（FR）&#10;&#10;L_PA：压缩同类异群组&#10;原型距离 Δ_rep&#10;→ 收窄 EO 上界&#10;&#10;梯度作用域：φ（引理2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="290" height="190" as="geometry" />
        </mxCell>

        <mxCell id="acc" value="精度路径（ACC）&#10;&#10;L_l2l：原型分类一致性&#10;→ 传导至样本级精度&#10;&#10;梯度作用域：w（引理6）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="820" y="215" width="290" height="190" as="geometry" />
        </mxCell>

        <mxCell id="e_fr" style="html=1;strokeColor=#B85450;strokeWidth=2;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="center" target="fr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fr_label" value="公平性信号" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#B85450;" vertex="1" connectable="0" parent="e_fr">
          <mxGeometry x="-0.15" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_acc" style="html=1;strokeColor=#82B366;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="center" target="acc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_acc_label" value="精度信号" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#82B366;" vertex="1" connectable="0" parent="e_acc">
          <mxGeometry x="-0.15" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="loop_label" value="一个闭环：原型贯穿 训练 — 通信 — 聚合" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=3;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="334" y="480" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="train" value="客户端局部训练&#10;L_PA + L_l2l 同时执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="530" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="comm" value="通信传输&#10;仅传 模型参数 + 原型&#10;（不传群组统计量）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="469" y="550" width="230" height="80" as="geometry" />
